// Construct 54 — Expression constraint (PSS 16.1.4, Syntax 54).
// `single_*` isolate one expression each; `expr_a` puts the three together.
package p54 {
    component c54 {
        action sum_a {
            rand int a; rand int b;
            constraint a in [0..10];
            constraint b in [0..10];
            constraint { a + b == 10; }
        };
        action prod_a {
            rand int a; rand int b;
            constraint a in [0..10];
            constraint b in [0..10];
            constraint { a * b <= 20; }
        };
        action lt_a {
            rand int a; rand int b;
            constraint a in [0..10];
            constraint b in [0..10];
            constraint { a < b; }
        };
        action expr_a {
            rand int a; rand int b;
            constraint a in [0..10];
            constraint b in [0..10];
            constraint { a + b == 10; }
            constraint { a * b <= 20; }
            constraint { a < b; }
        };
    };
};
