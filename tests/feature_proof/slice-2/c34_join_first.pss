// Construct 34 — join_first(1): a run-time dependency only. The following
// statement should still start after one branch has completed.
component pss_top {
   action A { rand int a; }
   action B { rand int b; }
   action C { rand int c; }
   action test {
      activity {
         L1: parallel join_first(1) {
            L2: do A;
            L3: do B;
         };
         L4: do C;
      };
   };
};
