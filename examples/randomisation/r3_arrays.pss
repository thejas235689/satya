// Randomisation example 3 — arrays and collections (PSS 7.9, 8.5, 16.1.6).
//
// `constraint foreach (a[i]) { ... }` is expanded into one constraint per
// element, so the idiomatic form works. `unique { ... }` is still parsed and
// dropped (see docs/FEATURES.md entry 59), and `a.sum()` inside a constraint is
// counted but not solved — so this example avoids both.
package rand_array_pkg {

    component rand_array_c {
        action array_a {
            rand bit[8] payload[8];
            rand int n;

            constraint n in [1..8];

            // One constraint per element, from a single `foreach`.
            constraint foreach (payload[i]) {
                payload[i] in [0..15];
            }
        };

        action sized_a {
            rand int ids[4];
            constraint foreach (ids[i]) {
                ids[i] in [1..4];
            }
        };
    };
};
