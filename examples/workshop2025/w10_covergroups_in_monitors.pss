// Example 10 — covergroups inside a monitor (slide 17).
//
// Data coverage combined with behavioral coverage: the covergroup is sampled at
// the first match of the cover statement, using that realization's handle
// mapping.
package w10_pkg {

    enum locked_e { LOCKED, UNLOCKED };
    enum write_mode_e { WRITE_BACK, WRITE_THRU };

    component w10_c {
        action read_a  { rand locked_e lock_mode; };
        action write_a { rand write_mode_e write_mode; };

        monitor m {
            write_a w;
            read_a  r;
            activity { w; r; }
            covergroup {
                cpw: coverpoint w.write_mode;
                cpr: coverpoint r.lock_mode;
                wXr: cross cpw, cpr;
            } cg;
        };

        action top_a {
            activity {
                do write_a;
                do read_a;
                cover m;
            }
        };
    };
};
