// PSS v3.0 LRM — Example 89: replicate statement with label array (page 165)
action my_compound {
  rand int in [2..4] count;
  activity {
    parallel {
      replicate (count) RL[]: {
        A a;
        B b;
        a;
        b;
      }
    }
    if (RL[count-1].a.x ==0) { // 'a' of the last replicate expansion
      do C;
    }
  }
};
action my_test {
  activity {
    do my_compound with {
      RL[0].a.x == 10; // 'a' of the first replicate expansion
    };
  }
};
