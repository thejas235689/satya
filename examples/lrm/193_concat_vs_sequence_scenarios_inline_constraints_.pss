// PSS v3.0 LRM — Example 193: Concat vs sequence scenarios. Inline constraints with different behavior (page 271)
c9: cover {
  read r;
  write w;
  activity {
    concat {
      do start;
      w;
      r with core == w.core;
    }
  }
}
c10: cover {
  read r;
  write w;
  activity {
    sequence {
      do start;
      w;
      r with core == w.core;
    }
  }
}

