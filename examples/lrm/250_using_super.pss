// PSS v3.0 LRM — Example 250: Using super (page 332)
import std_pkg::*;
action A {
  int a;
  exec pre_solve {
    a=1;
  }
  exec body {
    message(LOW,"Hello from A %d", a);
  }
}
action A1 : A {
  exec body {
    super;
    message(LOW,"Hello from A1 %d", a);
  }
}
action A2 : A {
  exec body {
    message(LOW,"Hello from A2 %d", a);
    super;
  }
}
