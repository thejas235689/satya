// PSS v3.0 LRM — Example 304: Packed PSS big-endian struct (page 418)
struct my_packed_struct : packed_s<LITTLE_ENDIAN> {
   bit[6] A;
   bit[2] B;
   bit[9] C;
   bit[7] D;
   bit[6] E;
}
