// PSS v3.0 LRM — Example 317: Recommended packaging (page 438)
// In my_IP_regs.pss
package my_IP_regs {
   import addr_reg_pkg::*;
 struct my_reg0_s : packed_s<> { ... };
  pure component my_reg0_c : reg_c<my_reg0_s, READWRITE, 32> { ... };
   // ... etc: other registers
  pure component my_reg_group_c : reg_group_c {
     my_reg0_c r0;
     // ... etc: other registers
  };
}

