// PSS v3.0 LRM — Example 249: Inheritance and shadowing (page 331)
import std_pkg::*;
action A {
  int a;
  exec pre_solve {
    a=1;
  }
  exec body {
    message(LOW,"Hello from A %d", a);
  }
}
action B : A {
  exec pre_solve {
    a=2;
  }
  exec body {
    message(LOW,"Hello from B %d", a);
  }
}
