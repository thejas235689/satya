// PSS v3.0 LRM — Example 75: Atomic block to avoid action interference (page 152)
action bringup_a {}
state config_s {
   rand mode_e mode;
}
action configX_a {
  output config_s out_cfg;
  constraint out_cfg.mode == X;
}
action A_a {}
action B_a {
  input config_s cfg;
  constraint cfg.mode == X;
}
action my_stress_seq_a {
  activity {
    do bringup_a;
    atomic {
      do A_a;
      do B_a;
    }
  }
}
bringup_a
A_a
configX_a
B_a
mode X
In reality, B_a may start
long after A_a. Stress is not
achieved because relevant
behavior is spaced apart or
diluted.
