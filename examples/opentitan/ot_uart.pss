//////////////////////////////////////////////////////////////////////////////////
// OpenTitan UART — a PSS model of the lowRISC/opentitan `uart` IP.
//
// Every register, field name, bit range and software-access attribute below is
// taken from  hw/ip/uart/data/uart.hjson  (OpenTitan, Apache-2.0); the byte
// offsets are the ones reggen assigns in declaration order (4-byte stride).
// Field identifiers are the HJSON names lower-cased, so the model can be
// diffed mechanically against the spec — see tools/ot_regmap_check.py.
//
//   CTRL          0x00  rw   TX[0] RX[1] NF[2] SLPBK[4] LLPBK[5]
//                            PARITY_EN[6] PARITY_ODD[7] RXBLVL[9:8] NCO[31:16]
//   RDATA         0x04  ro   (whole register)
//   WDATA         0x08  wo   (whole register)
//   FIFO_CTRL     0x0C  rw   RXILVL[4:2] TXILVL[7:5]
//   FIFO_STATUS   0x10  ro   TXLVL[7:0] RXLVL[23:16]
//   OVRD          0x14  rw   TXEN[0] TXVAL[1]
//   VAL           0x18  ro   RX[15:0]
//   TIMEOUT_CTRL  0x1C  rw   VAL[23:0] EN[31]
//
// This is not part of OpenTitan; it is a Satya model written against
// OpenTitan's published register interface.
//////////////////////////////////////////////////////////////////////////////////

package ot_uart_pkg {

   // UART0 base address in the OpenTitan top level (top_earlgrey).
   static const int UART0_BASE = 0x40000000;

   // Register offsets, in reggen declaration order.
   static const int CTRL_OFF         = 0x00;
   static const int RDATA_OFF        = 0x04;
   static const int WDATA_OFF        = 0x08;
   static const int FIFO_CTRL_OFF    = 0x0C;
   static const int FIFO_STATUS_OFF  = 0x10;
   static const int OVRD_OFF         = 0x14;
   static const int VAL_OFF          = 0x18;
   static const int TIMEOUT_CTRL_OFF = 0x1C;

   // CTRL.NCO[31:16] holds the baud-rate divisor.
   static const int NCO_MAX = 65535;

   // CTRL — UART control register (rw).
   struct uart_ctrl_s {
      rand bit[1] tx;          // CTRL.TX[0]          TX enable
      rand bit[1] rx;          // CTRL.RX[1]          RX enable
      rand bit[1] nf;          // CTRL.NF[2]          RX noise filter
      rand bit[1] slpbk;       // CTRL.SLPBK[4]       system loopback
      rand bit[1] llpbk;       // CTRL.LLPBK[5]       line loopback
      rand bit[1] parity_en;   // CTRL.PARITY_EN[6]
      rand bit[1] parity_odd;  // CTRL.PARITY_ODD[7]
      rand bit[2] rxblvl;      // CTRL.RXBLVL[9:8]    break-error detection level
      rand bit[16] nco;        // CTRL.NCO[31:16]     baud-rate divisor

      constraint nco >= 1;
      constraint nco <= NCO_MAX;
      constraint tx == 1;
      constraint rx == 1;
      // Odd parity is only meaningful when parity is enabled.
      constraint parity_odd == 1 -> parity_en == 1;
   };

   // FIFO_CTRL — interrupt watermarks (rw).
   struct uart_fifo_ctrl_s {
      rand bit[3] rxilvl;      // FIFO_CTRL.RXILVL[4:2]
      rand bit[3] txilvl;      // FIFO_CTRL.TXILVL[7:5]
      constraint rxilvl >= 1;
      constraint txilvl >= 1;
   };

   // FIFO_STATUS — FIFO levels (ro).
   struct uart_fifo_status_s {
      rand bit[8] txlvl;       // FIFO_STATUS.TXLVL[7:0]
      rand bit[8] rxlvl;       // FIFO_STATUS.RXLVL[23:16]
   };

   // OVRD — software override of the serial lines (rw).
   struct uart_ovrd_s {
      rand bit[1] txen;        // OVRD.TXEN[0]
      rand bit[1] txval;       // OVRD.TXVAL[1]
   };

   // VAL — sampled RX value (ro).
   struct uart_val_s {
      rand bit[16] rx;         // VAL.RX[15:0]
   };

   // TIMEOUT_CTRL — RX timeout (rw).
   struct uart_timeout_ctrl_s {
      rand bit[24] val;        // TIMEOUT_CTRL.VAL[23:0]
      rand bit[1] en;          // TIMEOUT_CTRL.EN[31]
   };

   // The configuration produced by `configure` and consumed downstream.
   buffer uart_config_b {
      rand uart_ctrl_s ctrl;
      rand uart_fifo_ctrl_s fifo;
      constraint ctrl.nco == 1085;      // 24 MHz / 115200 baud, rounded
   };

   // A byte written to WDATA, with the framing choice for the harness.
   buffer uart_frame_b {
      rand bit[8] data;
      rand int in [0..7] stop_bits;
   };
}

component uart_c {

   // --- register-level actions -------------------------------------------

   action configure {          // writes CTRL and FIFO_CTRL
      output uart_config_b cfg;
      constraint cfg.fifo.txilvl <= 3;
   };

   action write_byte {         // WDATA (swaccess wo)
      input uart_config_b cfg;
      output uart_frame_b frame;
   };

   action read_byte {          // RDATA (swaccess ro)
      input uart_config_b cfg;
   };

   action poll_status {        // FIFO_STATUS (swaccess ro)
      input uart_config_b cfg;
   };

   action set_override {       // OVRD (swaccess rw)
      rand uart_ovrd_s ovrd;
   };

   action read_value {         // VAL (swaccess ro)
      rand uart_val_s val;
   };

   action set_timeout {        // TIMEOUT_CTRL (swaccess rw)
      rand uart_timeout_ctrl_s timeout;
      constraint timeout.val >= 1;
   };
};

component ot_uart_top {

   uart_c uart;

   // Flow objects are recycled through a pool, as the workshop models do.
   pool uart_config_b config_pool;
   bind config_pool *;

   // The UART address window, as the firmware reference and bench backends
   // report it.
   exec init_up {
      uart_region.addr = 0x40000000;
      uart_region.size = 0x20;
   };

   action uart_smoke_test {
      rand int in [1..16] num_bytes;

      activity {
         do uart_c::configure;
         parallel {
            repeat (num_bytes) {
               do uart_c::write_byte;
            };
            do uart_c::poll_status;
         };
         do uart_c::read_byte;
         do uart_c::read_value;
         do uart_c::set_timeout;
         do uart_c::set_override;
      };
   };

   // A longer soak: interleave configuration with data movement.
   action uart_soak_test {
      activity {
         repeat (3) {
            do uart_c::configure;
            do uart_c::write_byte;
            do uart_c::read_byte;
         };
      };
   };
};
