+        >"$SWEEP_CACHE/$1.$2.tmp" 2>/dev/null; then
+        awk -v keys="$4" '
+            function emit(  j, line) {
+                if (seed == "") return
+                line = seed
+                for (j = 1; j <= nk; j++) line = line " " (got[j] ? val[j] : "-")
+                print line
+            }
+            BEGIN { nk = split(keys, K, " ") }
+            /^\/\* --- seed [0-9]+ --- \*\/$/ {
+                emit()
+                s = $0
+                sub(/^\/\* --- seed /, "", s); sub(/ --- \*\/$/, "", s)
+                seed = s
+                for (j = 1; j <= nk; j++) got[j] = 0
+                next
+            }
+            {
+                line = $0; sub(/^[ \t]+/, "", line)
+                if (substr(line, 1, 1) != "\"") next
+                i = index(substr(line, 2), "\"")
+                if (i == 0) next
